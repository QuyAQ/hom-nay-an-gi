
{
  "name": "what2eat-dev",
  "main": "worker.js",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "what2eat-catalog-dev",
      "database_id": "b67f2c88-2619-4d63-9881-b0138a107c08",
      "migrations_dir": "migrations"
    },
    {
      "binding": "USER_DB",
      "database_name": "what2eat-users-dev",
      "database_id": "8cc07d1d-789c-4c8b-a15a-c62d13798867",
      "migrations_dir": "migrations/users"
    }
  ]
}

