
{
  "name": "what2eat",
  "main": "worker.js",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "what2eat-catalog",
      "database_id": "def06ba4-dfc1-4865-b01a-568367a61e87",
      "migrations_dir": "migrations"
    }
  ]
}
